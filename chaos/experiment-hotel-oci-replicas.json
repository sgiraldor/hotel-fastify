{
  "version": "1.0.0",
  "title": "Hotel OCI — HTTP 503 en las dos réplicas (declarativo)",
  "description": "Chaos Toolkit orquesta el interruptor por pod vía chaos/replicas-toolkit.ps1 → chaos/chaos-replicas.ps1. No usa el NLB para activar ni para comprobar cobertura. Enable exige CHAOS_OCI_CONFIRM=YES. TTL por defecto 60 s (máximo de la API 300 s). validate o dry-run no demuestran ejecución real en OCI.",
  "tags": ["hotel", "oci", "replicas", "seguimiento-4", "declarative"],
  "configuration": {
    "observation_window_seconds": {
      "type": "env",
      "key": "CHAOS_OCI_OBSERVE_SEC",
      "default": "5"
    }
  },
  "steady-state-hypothesis": {
    "title": "Las dos réplicas Ready responden habitación 200 y /live 200",
    "probes": [
      {
        "type": "probe",
        "name": "both-replicas-healthy",
        "tolerance": 0,
        "provider": {
          "type": "process",
          "path": "powershell",
          "arguments": [
            "-NoProfile",
            "-File",
            "chaos/replicas-toolkit.ps1",
            "-Action",
            "status"
          ],
          "timeout": 90
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "enable-both-replicas",
      "provider": {
        "type": "process",
        "path": "powershell",
        "arguments": [
          "-NoProfile",
          "-File",
          "chaos/replicas-toolkit.ps1",
          "-Action",
          "enable"
        ],
        "timeout": 120
      }
    },
    {
      "type": "probe",
      "name": "both-replicas-return-503",
      "provider": {
        "type": "process",
        "path": "powershell",
        "arguments": [
          "-NoProfile",
          "-File",
          "chaos/replicas-toolkit.ps1",
          "-Action",
          "verify-active"
        ],
        "timeout": 90
      }
    },
    {
      "type": "action",
      "name": "wait-observation-window",
      "provider": {
        "type": "process",
        "path": "node",
        "arguments": [
          "-e",
          "const s=Number(process.env.CHAOS_OCI_OBSERVE_SEC||5); setTimeout(()=>{}, Math.max(1,s)*1000)"
        ],
        "timeout": 60
      }
    },
    {
      "type": "action",
      "name": "disable-both-replicas",
      "provider": {
        "type": "process",
        "path": "powershell",
        "arguments": [
          "-NoProfile",
          "-File",
          "chaos/replicas-toolkit.ps1",
          "-Action",
          "disable"
        ],
        "timeout": 90
      }
    },
    {
      "type": "probe",
      "name": "both-replicas-recovered",
      "provider": {
        "type": "process",
        "path": "powershell",
        "arguments": [
          "-NoProfile",
          "-File",
          "chaos/replicas-toolkit.ps1",
          "-Action",
          "status"
        ],
        "timeout": 90
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "emergency-disable-both-replicas",
      "provider": {
        "type": "process",
        "path": "powershell",
        "arguments": [
          "-NoProfile",
          "-File",
          "chaos/replicas-toolkit.ps1",
          "-Action",
          "disable"
        ],
        "timeout": 90
      }
    }
  ]
}
