{
  "chaoslib-version": "1.45.1",
  "platform": "Linux-7.0.0-1019-azure-x86_64-with-glibc2.43",
  "node": "runnervmccnms",
  "experiment": {
    "version": "1.0.0",
    "title": "Chaos gate Hotel — HTTP 503 en el runner",
    "description": "Indisponibilidad controlada solo contra http://127.0.0.1:3000. La inyección caduca a los 15 s. Mide 503 en habitación, 200 en /live y recuperación en menos de 5 s.",
    "tags": [
      "hotel",
      "chaos-gate",
      "localhost"
    ],
    "configuration": {
      "hotel_base_url": {
        "type": "env",
        "key": "HOTEL_BASE_URL",
        "default": "http://127.0.0.1:3000"
      },
      "chaos_lab_token": {
        "type": "env",
        "key": "CHAOS_LAB_TOKEN"
      },
      "habitacion_id": {
        "type": "env",
        "key": "HOTEL_HABITACION_ID",
        "default": "1"
      }
    },
    "steady-state-hypothesis": {
      "title": "Habitación y /live responden 200 antes de inyectar",
      "probes": [
        {
          "type": "probe",
          "name": "steady-live",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${hotel_base_url}/live",
            "timeout": 5
          }
        },
        {
          "type": "probe",
          "name": "steady-habitacion",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${hotel_base_url}/api/v2/habitacion/${habitacion_id}",
            "headers": {
              "x-trace-id": "gate-steady"
            },
            "timeout": 5
          }
        }
      ]
    },
    "method": [
      {
        "type": "action",
        "name": "enable-hotel-chaos",
        "provider": {
          "type": "http",
          "url": "${hotel_base_url}/api/v2/chaos/dependency",
          "method": "POST",
          "headers": {
            "x-chaos-token": "${chaos_lab_token}",
            "Content-Type": "application/json"
          },
          "arguments": {
            "action": "enable",
            "durationSeconds": 15
          },
          "timeout": 5
        }
      },
      {
        "type": "probe",
        "name": "habitacion-503-1",
        "provider": {
          "type": "process",
          "path": "node",
          "arguments": [
            "chaos/gate-probe.mjs",
            "inject-habitacion",
            "--expect",
            "503"
          ],
          "timeout": 10
        }
      },
      {
        "type": "probe",
        "name": "habitacion-503-2",
        "provider": {
          "type": "process",
          "path": "node",
          "arguments": [
            "chaos/gate-probe.mjs",
            "inject-habitacion",
            "--expect",
            "503"
          ],
          "timeout": 10
        }
      },
      {
        "type": "probe",
        "name": "habitacion-503-3",
        "provider": {
          "type": "process",
          "path": "node",
          "arguments": [
            "chaos/gate-probe.mjs",
            "inject-habitacion",
            "--expect",
            "503"
          ],
          "timeout": 10
        }
      },
      {
        "type": "probe",
        "name": "live-durante-el-fallo",
        "provider": {
          "type": "process",
          "path": "node",
          "arguments": [
            "chaos/gate-probe.mjs",
            "inject-live",
            "--expect",
            "200"
          ],
          "timeout": 10
        }
      },
      {
        "type": "action",
        "name": "disable-hotel-chaos",
        "provider": {
          "type": "http",
          "url": "${hotel_base_url}/api/v2/chaos/dependency",
          "method": "POST",
          "headers": {
            "x-chaos-token": "${chaos_lab_token}",
            "Content-Type": "application/json"
          },
          "arguments": {
            "action": "disable"
          },
          "timeout": 5
        }
      },
      {
        "type": "action",
        "name": "marcar-disable",
        "provider": {
          "type": "process",
          "path": "node",
          "arguments": [
            "chaos/gate-probe.mjs",
            "mark-disable"
          ],
          "timeout": 10
        }
      },
      {
        "type": "probe",
        "name": "habitacion-recuperada",
        "provider": {
          "type": "process",
          "path": "node",
          "arguments": [
            "chaos/gate-probe.mjs",
            "recovery-habitacion",
            "--expect",
            "200"
          ],
          "timeout": 15
        }
      }
    ],
    "rollbacks": [
      {
        "type": "action",
        "name": "force-disable-hotel-chaos",
        "provider": {
          "type": "http",
          "url": "${hotel_base_url}/api/v2/chaos/dependency",
          "method": "POST",
          "headers": {
            "x-chaos-token": "${chaos_lab_token}",
            "Content-Type": "application/json"
          },
          "arguments": {
            "action": "disable"
          },
          "timeout": 5
        }
      }
    ],
    "dry": null
  },
